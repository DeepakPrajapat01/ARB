# Spring Boot configuration
# Define the implicit location for Google Application Default Credentials
# This allows Firebase Admin to automatically discover the credentials without hardcoding secrets in Java.
# Point this to your downloaded service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/firebase-service-account.json


